# Example only. Set secrets in Render's environment settings, never in Godot.
PORT=8787
PVP_DATA_DIR=artifacts/pvp-data
# Exact Origins, comma separated. Use the iframe host for an itch.io export.
PVP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PVP_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
# Optional locally; configure both for persistent production match logs.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
