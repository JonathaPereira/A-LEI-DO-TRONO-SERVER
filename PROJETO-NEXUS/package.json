{
  "name": "projeto-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus: Ecos do Crepúsculo — protótipo original de combate tático 3 contra 3",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "build:pages": "node scripts/build-site.mjs --pages",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser.mjs",
    "test:site": "npm run build && node --test tests/site.mjs",
    "sync:godot": "node scripts/sync-godot.mjs",
    "test:godot": "node scripts/test-godot.mjs",
    "check": "node --check src/app.js && node --check src/engine.js && node --check src/art.js",
    "pvp:server": "node server/pvp.mjs",
    "test:pvp": "node --test tests/pvp.test.js",
    "build:game": "node scripts/export-game.mjs",
    "test:pvp:godot": "node scripts/test-pvp-godot.mjs",
    "serve:game": "node scripts/serve-game.mjs",
    "test:pvp:web": "node scripts/test-pvp-web.mjs",
    "test:audio:web": "node scripts/test-audio-web.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "fflate": "^0.8.3"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
