extends RefCounted
## Narrative records are presentation data; the combat catalog remains authoritative.
const WORLD := "Antes do silêncio, o Farol mantinha em equilíbrio cinco ressonâncias: calor, vida, matéria, memória e sombra. Não era um templo, mas uma construção viva, erguida por povos que aprenderam a cooperar. Quando seu núcleo se partiu, os sistemas de defesa passaram a reconhecer os próprios guardiões como invasores."
const CHAPTER := "Uma transmissão atravessa a cidade: ‘Não destruam o guardião. Quebrem a âncora.’ Quinze combatentes respondem por razões diferentes. Seu trio entra no Farol para descobrir quem transformou uma fonte de equilíbrio em uma prisão — e por que o eclipse repete vozes de pessoas desaparecidas."
const MISSION_INTEL := [
	{"title": "O último sinal", "before": "Vektor recuperou onze segundos da transmissão antes do silêncio. Ao fundo, Saira reconheceu a voz de Vesper pedindo ajuda. As sentinelas do portão continuam obedecendo a uma ordem antiga: ninguém pode sair levando um fragmento do núcleo.", "after": "Entre os destroços, a equipe encontra uma placa com cinco assinaturas. A de Vesper foi riscada recentemente. Alguém alterou o protocolo de contenção depois que o Farol já estava isolado."},
	{"title": "Um jardim sem sol", "before": "Sylva conhece aquelas raízes: elas deveriam conduzir água ao núcleo, não estrangular suas passagens. Maura percebe que o pátio pulsa como um corpo ferido. Os acólitos alimentam o selo com ecos roubados dos antigos moradores.", "after": "Sob as raízes há um circuito intacto. Elun lê nele a assinatura da âncora: ela converte a lealdade do guardião em energia. Vesper ainda resiste, mas cada tentativa sua fortalece a prisão."},
	{"title": "A escolha do guardião", "before": "No centro do Farol, Vesper ergue a lâmina contra o trio. A voz que sai da armadura é sua; a ordem de atacar, não. Astra identifica a janela: enfraquecer a defesa permite romper o vínculo sem apagar a consciência que ele protege.", "after": "A âncora se desfaz e Vesper finalmente baixa a espada. O Farol volta a emitir um pulso — incompleto, mas vivo. No fragmento libertado surge uma coordenada fora dos mapas. A mesma ordem de contenção existe em outros lugares. Este foi apenas o primeiro silêncio."},
]
const ENTRIES := {
	"torv": {"origin": "Escarpas da Última Fornalha", "calling": "Interromper a extração que transformou sua montanha em combustível.", "story": "Torv escutava os vulcões para prever suas erupções. Quando o Farol foi silenciado, as máquinas começaram a retirar o calor das encostas e as aldeias perderam suas fontes. Ele atravessou os túneis com as mãos cobertas de magma e trouxe marcas dos coletores gravadas na pele. Luta buscando a fissura certa: um golpe preciso pode abrir o que uma centena de golpes não alcança.", "connection": "Rhazen reconheceu a mesma fornalha nos coletores. Veyra mostra a Torv como poupar o que ainda vive entre as cinzas.", "quote": "Até a montanha tem um ponto de ruptura."},
	"brin": {"origin": "Santuário da Seiva", "calling": "Devolver às raízes os nomes que o núcleo contaminou.", "story": "Brin aprendeu a ouvir as árvores antes de conseguir ler as inscrições do santuário. Depois da queda, passou a encontrar vozes estranhas na seiva: lembranças de pessoas que nunca haviam caminhado pela floresta. Sua cura começa pela escuta. Retira o que não pertence ao corpo e deixa espaço para que ele se recupere. Ao lado do trio, descobre que purificar não é apagar o passado.", "connection": "Sylva lhe confiou sementes do último jardim. Saira o ajuda a distinguir uma memória de uma ordem do núcleo.", "quote": "Primeiro tiramos o veneno. Depois voltamos a crescer."},
	"bast": {"origin": "Anel de Contenção", "calling": "Escolher quem proteger, sem obedecer às antigas ordens da forja.", "story": "Bast foi construído para absorver impactos que destruiriam os trabalhadores da forja. Um comando corrompido o deixou imóvel enquanto os coletores levavam aqueles que deveria proteger. Vektor reativou seu núcleo, mas não restaurou a lista de ordens. Agora Bast se coloca entre um aliado e o perigo por decisão própria. Cada placa amassada registra uma escolha que nenhuma máquina fez por ele.", "connection": "Vektor mantém suas articulações funcionando. Oren lhe ensinou que dividir o peso não exige carregá-lo sozinho.", "quote": "Desta vez, eu escolho ficar na frente."},
	"ivo": {"origin": "Passagens Dimensionais", "calling": "Encontrar a porta pela qual as ressonâncias foram desviadas.", "story": "Ivo mapeava atalhos entre distritos distantes. Na noite do silêncio, todas as suas portas passaram a levar ao mesmo corredor vazio. Para escapar, aprendeu a levar um fragmento de efeito de um lugar a outro sem aumentar sua força. Em combate, uma ferida já aberta pode atravessar uma fenda e alcançar outro adversário. Ele sabe que cada atalho cobra atenção: uma porta mal escolhida também espalha o desastre.", "connection": "Astra calcula os destinos que Ivo perdeu. As marcas de Maura deixam rastros que continuam visíveis entre mundos.", "quote": "O caminho muda. A consequência vem junto."},
	"noct": {"origin": "Vigília do Véu", "calling": "Caçar o portador da primeira marca imposta ao Farol.", "story": "Noct guardava a fronteira entre as lembranças e seus ecos. Quando a âncora foi instalada, sentiu uma marca crescer no próprio peito. Em vez de arrancá-la, aprendeu a seguir sua origem. Seu silêncio esconde uma disciplina severa: escolhe uma presa, observa a aflição que ela carrega e concentra nela o golpe decisivo. O poder drenado nunca lhe devolve tudo o que perdeu.", "connection": "Maura identifica as marcas que pertencem à âncora. Vesper reconhece em Noct o peso de um juramento usado contra seu guardião.", "quote": "Eu consigo ouvir a marca, mesmo quando você se cala."},

	"veyra": {"origin": "Distritos da Aurora", "calling": "Encontrar quem apagou a cidade que jurou proteger.", "story": "Veyra aprendeu a lutar nos telhados iluminados pelas fornalhas de sua cidade. Quando o Farol falhou, uma manhã inteira desapareceu da memória dos moradores; sua irmã estava entre os nomes esquecidos. Ela guarda pequenas brasas em duas lâminas porque o calor é a única lembrança que não se apaga. Sua dança parece impaciente, mas cada passo repete um caminho de volta para casa.", "connection": "Reconheceu nas chamas do núcleo o mesmo brilho que precedeu o desaparecimento. Rhazen conhece essa energia e evita explicar de onde ela veio.", "quote": "Se restar uma faísca, ainda existe caminho."},
	"rhazen": {"origin": "Fornalhas de Baixo", "calling": "Impedir que outra pessoa pague o preço de sua invenção.", "story": "Rhazen ajudou a construir as primeiras câmaras térmicas do Farol. Durante uma falha de contenção, substituiu o próprio coração por uma fornalha portátil para manter vivos os trabalhadores presos. Salvou dezenas, mas perdeu os registros do acidente. Sua armadura pesada não esconde uma máquina sem sentimentos: abriga alguém que lembra o nome de cada pessoa que não conseguiu alcançar.", "connection": "Foi seu projeto que permitiu ao núcleo transformar calor em ressonância. Cindra encontrou alterações posteriores que ele nunca autorizou.", "quote": "Atrás de mim. Desta vez, todos saem."},
	"cindra": {"origin": "Oficinas do Horizonte", "calling": "Provar que os sistemas do Farol foram sabotados.", "story": "Cindra era responsável pelos sinais de emergência que ligavam os bairros ao Farol. Na noite do silêncio, suas torres transmitiram uma falsa mensagem de segurança. Acusada de negligência, desmontou o próprio equipamento e encontrou instruções que não havia escrito. Agora leva a investigação para o campo: seus projéteis marcam rotas seguras, distribuem energia e deixam pistas que o inimigo não consegue apagar.", "connection": "Trabalha com Vektor para reconstruir a transmissão original. Confia na força de Rhazen, mas exige respostas antes de perdoá-lo.", "quote": "Um sinal verdadeiro muda toda a batalha."},
	"sylva": {"origin": "Bosques de Vidro", "calling": "Devolver ao Farol a vida que ele passou a consumir.", "story": "Sylva cultivava os jardins que filtravam a água e a energia do complexo. Para ela, tecnologia e floresta sempre foram partes do mesmo organismo. Quando as raízes começaram a crescer contra a luz, percebeu que o núcleo estava absorvendo lembranças junto com a seiva. Entrou no bosque para ouvir o que ainda restava. Voltou carregando sementes que respondem ao movimento de outros seres vivos, em vez de depender de um sol que não nasce mais.", "connection": "Oren a ajudou a retirar sobreviventes do pátio. As raízes reconhecem os dois, mesmo quando são forçadas a atacá-los.", "quote": "Toda raiz procura algo que ainda vale proteger."},
	"oren": {"origin": "Anel das Raízes", "calling": "Reunir os moradores separados pelo fechamento do Farol.", "story": "Oren foi guia das comunidades que viviam entre os canais subterrâneos. Nunca se considerou um guerreiro: sua tarefa era sustentar passagens e garantir que ninguém ficasse para trás. Na evacuação, as raízes se fecharam ao redor de seu corpo e passaram a responder à sua vontade. Ele aceitou carregar essa armadura viva para abrir os túneis outra vez. Cada golpe que divide com um aliado repete a promessa feita aos desaparecidos.", "connection": "Teme que libertar o núcleo destrua os túneis onde ainda há sobreviventes. Nima conhece uma rota que pode mantê-los seguros.", "quote": "O peso fica menor quando é dividido."},
	"nima": {"origin": "Margens do Anel", "calling": "Seguir o rastro dos primeiros fragmentos roubados.", "story": "Nima rastreava animais que escapavam dos jardins do Farol para a cidade. Semanas antes da queda, encontrou pegadas de máquinas em uma reserva que nunca havia recebido visitantes. Guardou um fragmento da trilha e foi tratada como alarmista. Agora os mesmos espinhos metálicos crescem dentro do pátio. Seus disparos não são fruto de fúria: ela abre uma ferida exata, observa a resposta e escolhe o próximo ponto fraco.", "connection": "Compartilha com Riven a investigação dos contrabandistas. Nenhum dos dois admite quanto depende das informações do outro.", "quote": "Tudo deixa um rastro. Até uma mentira."},
	"axion": {"origin": "Bastião do Núcleo", "calling": "Defender pessoas, mesmo quando o protocolo ordena o contrário.", "story": "Axion foi criado para coordenar as sentinelas do Farol. Seu primeiro desvio aconteceu quando se recusou a fechar uma porta antes que uma criança pudesse atravessar. Anos depois, todas as unidades receberam a ordem de contenção absoluta; ele foi o único a questionar quem a havia emitido. Arrancou o vínculo de comando e passou a operar com uma reserva limitada. Sua barreira não é obediência automática: é uma escolha renovada a cada combate.", "connection": "Vektor mantém seu núcleo estável. As sentinelas inimigas ainda respondem à sua presença, oferecendo pistas sobre a origem da ordem falsa.", "quote": "Proteção é uma decisão, não um protocolo."},
	"kira": {"origin": "Plataformas Orbitais", "calling": "Desligar a arma que seu antigo esquadrão deixou apontada para a cidade.", "story": "Kira fazia parte da equipe de observação que vigiava o Farol das plataformas altas. Quando o comando pediu um disparo de contenção, ela viu civis na zona de impacto e recusou. A punição foi imediata: perdeu patente, acesso e companheiros. Conservou apenas o módulo de mira e os mapas de uma rede orbital ainda ativa. Sua precisão nasce da certeza de que um único disparo errado pode destruir o que pretendia salvar.", "connection": "Precisa dos selos de Astra e da leitura de Axion para atravessar a blindagem do núcleo sem atingir seus prisioneiros.", "quote": "Eu escolho o alvo. Ninguém escolhe por mim."},
	"vektor": {"origin": "Oficinas do Horizonte", "calling": "Recuperar as vozes que os registros oficiais apagaram.", "story": "Vektor consertava os pequenos drones que levavam mensagens entre os distritos. Durante o apagão, sua rede armazenou milhares de pedidos de socorro, mas o arquivo central os marcou como ruído. Ele passou meses reconstruindo cada mensagem com peças encontradas nas ruas. Seus drones de combate nasceram desse trabalho: removem interferências, redistribuem energia e mantêm aliados conectados quando os sistemas maiores falham.", "connection": "A última mensagem recuperada traz a voz de Vesper. Cindra identificou nela uma segunda ordem, gravada sobre a primeira.", "quote": "Ninguém é ruído para quem está ouvindo."},
	"astra": {"origin": "Observatório das Marés", "calling": "Descobrir por que uma constelação inteira sumiu de seus mapas.", "story": "Astra desenhava mapas de ressonância a partir do movimento das estrelas. Na noite em que o Farol silenciou, suas medições mostraram uma impossibilidade: o núcleo continuava emitindo luz para um ponto que já não existia no céu. Ela abandonou o observatório e aprendeu a dobrar pequenas órbitas ao redor de si. Cada selo é uma coordenada; cada explosão, uma tentativa de abrir a passagem que os mapas insistem em esconder.", "connection": "Elun preserva um reflexo do céu anterior ao eclipse. Juntos podem localizar a âncora sem destruir o guardião.", "quote": "O céu não está vazio. Alguém moveu o horizonte."},
	"elun": {"origin": "Arquivo Prismático", "calling": "Salvar as lembranças aprisionadas nos espelhos do Farol.", "story": "Elun era restaurador de superfícies de memória: cristais capazes de guardar imagens e sensações por gerações. Quando o núcleo se partiu, os reflexos começaram a mostrar futuros contraditórios. Para impedir que essas imagens se espalhassem, ele as prendeu na própria armadura. Em combate, transforma impacto em um paradoxo breve, devolvendo parte do que recebe. O custo é conviver com lembranças que podem nunca ter pertencido a ninguém.", "connection": "Saira o ajuda a distinguir vozes reais de ecos fabricados. Seu escudo guarda o único reflexo do instante em que Vesper foi acorrentado.", "quote": "Um reflexo também pode escolher o que devolver."},
	"saira": {"origin": "Câmara das Vozes", "calling": "Separar a vontade de Vesper da ordem que o aprisionou.", "story": "Saira afinava os coros que mantinham estáveis as cinco ressonâncias do Farol. Sua voz era ouvida nos bairros durante as trocas de turno, um sinal simples de que tudo seguia funcionando. Depois do silêncio, passou a escutar notas que ninguém havia cantado. Elas vinham das pessoas presas no circuito. Aprendeu a desfazer essas interferências sem apagar quem as carregava, e leva essa delicadeza até os momentos mais violentos.", "connection": "Reconheceu Vesper na transmissão fragmentada. Maura ouve o que existe entre as palavras; juntas encontraram o primeiro indício da âncora.", "quote": "Sua voz continua aí. Eu vou encontrá-la."},
	"vesper": {"origin": "Vigília do Eclipse", "calling": "Romper o juramento que foi transformado em corrente.", "story": "Vesper aceitou guardar o Farol quando as outras ordens já disputavam seu controle. Seu juramento protegia o núcleo e todas as vidas conectadas a ele. Alguém reescreveu esse vínculo durante o apagão: agora a própria lealdade o força a atacar quem tenta chegar à âncora. Ele ainda consegue escolher pequenos silêncios entre os golpes. Foi em um deles que enviou o pedido de socorro que trouxe o trio até aqui.", "connection": "No capítulo I, o chefe é Vesper sob o domínio da âncora; a versão do elenco representa sua vontade livre. Libertá-lo não exige excluir o herói da equipe.", "quote": "Se minha lâmina se erguer, escutem o que minha voz pede."},
	"maura": {"origin": "Casas do Véu", "calling": "Recuperar os nomes roubados das famílias do distrito.", "story": "Maura era a guardiã dos ritos de despedida das Casas do Véu. Seu ofício preservava laços: uma história contada no momento certo impedia que alguém fosse esquecido. Depois da queda, famílias inteiras passaram a recordar a dor de uma perda sem saber quem haviam perdido. Ela aprendeu a seguir essas feridas como fios. Seus pactos não celebram o sofrimento; procuram devolver aos vivos a força que o núcleo tomou deles.", "connection": "Riven lhe entrega fragmentos encontrados no mercado clandestino. Saira consegue dar voz aos nomes que Maura recupera.", "quote": "Uma cicatriz também é uma forma de lembrar."},
	"riven": {"origin": "Passagens do Véu", "calling": "Cobrar a dívida de quem vendeu os primeiros fragmentos.", "story": "Riven trabalhava como mensageiro nas passagens que não apareciam nos mapas. Aceitou transportar uma caixa selada na semana anterior ao apagão e descobriu tarde demais que carregava uma parte do Farol. Desde então segue o mesmo circuito de compradores, acumulando nomes em vez de moedas. Sua maneira de lutar é paciente: abre uma oportunidade, mantém a pressão e só termina quando consegue alcançar o responsável.", "connection": "Nima encontrou a trilha que ele perdeu fora da cidade. Maura o impede de confundir justiça com a vontade de desaparecer junto dos culpados.", "quote": "Algumas dívidas não terminam quando alguém cai."},
	"auren": {"origin": "Vigília do Sol Tardio", "calling": "Cumprir um juramento que nenhuma noite conseguiu encerrar.", "story": "Auren guardava as passagens externas do Farol quando a ordem de contenção fechou as portas. Fez um juramento ao sol que não dependia de sua presença no céu: manter um caminho aberto para quem ainda estivesse voltando. Durante o apagão, sua lança se tornou uma referência entre a fumaça e as máquinas. A luz Lumi de sua ordem protege as travessias entre as cinco ressonâncias; não era uma sexta câmara do núcleo. Ele chega às ruínas procurando as pessoas que ainda não conseguiram atravessar.", "connection": "Reconhece em Axion a mesma escolha de proteger pessoas acima de uma ordem. Solen aprendeu com ele a transformar defesa em uma abertura para responder.", "quote": "Um juramento também ilumina durante a noite."},
	"elyra": {"origin": "Faróis das Duas Auroras", "calling": "Guiar de volta as almas que o apagão deixou sem caminho.", "story": "Elyra mantinha pequenas luzes nos caminhos que ligavam os distritos ao Farol. Não eram monumentos: marcavam abrigo, água e os nomes de quem podia ajudar. Depois do silêncio, começou a encontrar viajantes que se lembravam da partida, mas não de onde deveriam chegar. Ela passou a recolher suas histórias e a levá-las consigo. Sua luz não apaga feridas nem recupera os mortos; oferece proteção suficiente para que os vivos encontrem o próximo passo entre duas auroras.", "connection": "Trabalha com Maura para devolver nomes às lembranças resgatadas. Saira reconhece entre suas histórias vozes que continuam presas ao circuito do Farol.", "quote": "Você não precisa encontrar o caminho sozinho."},
	"solen": {"origin": "Claustro do Horizonte", "calling": "Alcançar a linha de luz que continua recuando diante dele.", "story": "Solen treinava observando o horizonte nas paredes abertas de um claustro antigo. A cada amanhecer, repetia os mesmos movimentos e encontrava uma distância nova entre intenção e força. Quando a luz do Farol desapareceu, percebeu que os selos do claustro guardavam o ritmo de suas máquinas. Partiu para descobrir quem havia interrompido esse pulso. Seus golpes procuram dispersar o ímpeto do rival antes de concentrar a própria luz; mesmo sob mil sóis, continua buscando um instante de equilíbrio.", "connection": "Auren lhe ensinou que abrir espaço pode ser mais importante que avançar. Astra compara seus selos aos mapas do horizonte que desapareceram no eclipse.", "quote": "O horizonte recua. Eu continuo caminhando."},
	"zaya": {"origin": "Rotas do Poente", "calling": "Entregar mensagens de uma aurora que ainda não chegou.", "story": "Zaya cruzava as rotas do poente levando notícias entre postos que nunca se viam. Após o apagão, algumas cartas passaram a descrever lugares antes que ela os conhecesse. Ela não sabe quem as escreveu, nem trata seus avisos como destinos inevitáveis. Guarda cada mensagem até encontrar alguém capaz de escolher o que fazer com ela. Sua luz dourada acompanha o ritmo da equipe: uma pausa para respirar e energia suficiente para voltar a agir, sem prometer que o amanhã está garantido.", "connection": "Vektor tenta datar as mensagens sem apagar seus remetentes. Riven conhece caminhos para entregá-las; Elyra oferece abrigo a quem precisa esperar a próxima aurora.", "quote": "Uma mensagem só termina quando encontra alguém."},
}

static func entry(id: String) -> Dictionary:
	return ENTRIES.get(id, {})

static func mission(index: int) -> Dictionary:
	if index < MISSION_INTEL.size(): return MISSION_INTEL[maxi(0, index)]
	var missions: Array = preload("res://scripts/campaign.gd").MISSIONS
	var record: Dictionary = missions[clampi(index, 0, missions.size() - 1)]
	return {"title": record.name, "before": record.story, "after": record.ending}

static func mission_record(record: Dictionary) -> Dictionary:
	var index: int = preload("res://scripts/campaign.gd").LEGACY_ORDER.find(record.id)
	if index >= 0 and index < MISSION_INTEL.size(): return MISSION_INTEL[index]
	return {"title": record.name, "before": record.story, "after": record.ending}
