{
  "name": "mn-trono",
  "version": "0.14.0-alpha",
  "private": true,
  "description": "Aplicativo desktop e web de comunicação e jogos",
  "main": "server/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "start:frontend": "node scripts/serve-frontend.js",
    "desktop:install": "npm --prefix electron ci",
    "desktop:start": "node scripts/start-desktop.cjs",
    "desktop:build:native": "npm --prefix electron run build:native",
    "desktop:package": "npm run build && npm --prefix electron run pack:win",
    "build:manual": "node scripts/build-law-assets.js && node scripts/build-manual.js && node scripts/print-manual.js",
    "server:dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "predev": "node scripts/prepare-renderer.cjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-renderer.cjs",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "format": "prettier --write src server electron scripts",
    "format:check": "prettier --check src server electron scripts",
    "desktop:dev": "node scripts/dev-desktop.cjs",
    "postbuild": "node scripts/prepare-static-html.cjs",
    "database:prepare": "node scripts/prepare-database.cjs",
    "test": "node scripts/test.cjs"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "express": "^4.21.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
