{
  "name": "mn-trono-desktop",
  "version": "0.2.14",
  "description": "M&N e A Lei do Trono — aplicativo Windows",
  "author": "Jonatha Pereira",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "install-electron",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "build:native": "node ../scripts/build-native.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.jonatha.mn.trono",
    "compression": "maximum",
    "productName": "MN Trono",
    "artifactName": "MN-Trono-${version}-Windows.${ext}",
    "directories": {
      "output": "../../artifacts/windows-app"
    },
    "files": [
      "*.cjs",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!downloads/**",
          "!manual/A_Lei_do_Trono_Manual_v0.4_Edicao_Visual.pdf",
          "!roguelite/assets/**"
        ]
      },
      {
        "from": "../../artifacts/native-audio/Release/MN-Application-Audio.exe",
        "to": "native/MN-Application-Audio.exe"
      },
      {
        "from": "../../artifacts/native-audio/Release/MN-Remote-Input.exe",
        "to": "native/MN-Remote-Input.exe"
      },
      {
        "from": "../native-audio/vendor/ViGEmClient/LICENSE",
        "to": "native/ViGEmClient-LICENSE.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://a-lei-do-trono.surge.sh/downloads/",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
