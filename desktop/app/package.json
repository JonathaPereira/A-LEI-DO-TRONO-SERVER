{
  "name": "mn-trono-desktop",
  "version": "0.1.0",
  "description": "M&N e A Lei do Trono — aplicativo Windows",
  "author": "Jonatha Pereira",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "install-electron",
    "pack:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.jonatha.mn.trono",
    "productName": "MN Trono",
    "artifactName": "MN-Trono-${version}-Windows.${ext}",
    "directories": {"output": "../../artifacts/windows-app"},
    "files": ["*.cjs", "package.json", "assets/**"],
    "extraResources": [{"from": "../../frontend", "to": "frontend"}],
    "win": {"target": "nsis", "icon": "assets/icon.png"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false}
  }
}
